# Copy to .env for local runs (never commit .env).
# Local MySQL 8 (offline demo):
DATABASE_URL=mysql+pymysql://debtlens:debtlens@localhost:3306/debtlens
# or quick try-out without MySQL:
# DATABASE_URL=sqlite:///debtlens-local.db

# On Vercel these come from the TiDB Cloud integration (DATABASE_URL or TIDB_* variables).
# JWT_SECRET is optional on Vercel: if unset, a key is derived from the database credentials.
# JWT_SECRET=change-me
# Optional: raises the GitHub API limit for website repo mining / issue import
# GITHUB_TOKEN=
# Set to 1 to run without the MiniLM model (char n-gram fallback)
# DEBTLENS_DISABLE_ML=0
